# Copier en .env et compléter. Ce fichier ne doit jamais être commité.

# Paramètres physiologiques (calcul TRIMP / HRSS et zones FC sur la LTHR)
HR_MAX=190
HR_REST=50
LTHR=170
SEX=m

# Fuseau horaire (heure de la synchro quotidienne)
TZ=Europe/Paris

# Utilisateur et groupe propriétaires du dossier data (commande `id`).
# Le conteneur tourne sous cet utilisateur.
PUID=1000
PGID=1000

# Facultatif : identifiants Garmin Connect. Sinon, connexion depuis l'admin
# (avec le choix de mémoriser ou non le mot de passe).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Admin (/admin) : identifiant et hash argon2 du mot de passe, générés par
#   docker compose run --rm garmin-fitness-trend python -m app.auth
# Garder les guillemets simples (le hash contient des $).
ADMIN_USER=greg
ADMIN_PASSWORD_HASH=''
